        new ProjectItem {
            Title = "Fluent Wait & Retry Strategy", Level = "Intermediate", Time = "5h", Tech = "DefaultWait + Polling",
            Desc = "Implement custom wait strategies with polling intervals, ignored exceptions, and retry logic for flaky elements.",
            Steps = new List<string> { "Implement WebDriverWait with custom conditions", "Create FluentWait with polling interval", "Configure ignored exceptions list", "Build custom ExpectedConditions methods", "Implement retry wrapper for flaky tests", "Compare performance of wait strategies" }
        },

