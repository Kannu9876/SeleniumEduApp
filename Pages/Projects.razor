        new ProjectItem {
            Title = "Professional POM Framework", Level = "Advanced", Time = "15h", Tech = "Page Object Model + Base Classes",
            Desc = "Create a production-grade maintainable framework using POM design pattern with inheritance and encapsulation.",
            Steps = new List<string> { "Design BasePage class with common methods", "Create Page Classes for each application page", "Implement PageFactory-style element initialization", "Write test classes without any locators", "Add configuration management (appsettings.json)", "Implement ExtentReports for visual HTML reports" }
        },
        new ProjectItem {
            Title = "GitHub Actions CI/CD Pipeline", Level = "Advanced", Time = "5h", Tech = "CI/CD + Headless + YAML",
