            Steps = new List<string> { "Configure ChromeOptions for headless execution", "Write .github/workflows/test.yml pipeline", "Set up triggers for push and pull_request events", "Install dependencies and run tests in pipeline", "Upload test reports as GitHub Artifacts", "Add status badge to repository README" }
        },
        new ProjectItem {
            Title = "Selenium Grid Distributed Testing", Level = "Advanced", Time = "10h", Tech = "Selenium Grid 4 + Docker",
            Desc = "Set up Selenium Grid with Hub and Node architecture for parallel cross-browser testing using Docker containers.",
            Steps = new List<string> { "Install Docker and pull Selenium images", "Configure docker-compose.yml with Hub + Nodes", "Write tests targeting RemoteWebDriver", "Execute tests in parallel across Chrome, Firefox, Edge", "Monitor test execution on Grid Console", "Scale nodes dynamically based on test load" }
        },
        new ProjectItem {
            Title = "BDD Framework with SpecFlow", Level = "Advanced", Time = "12h", Tech = "SpecFlow + Gherkin + NUnit",
            Desc = "Build a Behavior-Driven Development framework where test scenarios are written in plain English Gherkin syntax.",
            Steps = new List<string> { "Install SpecFlow NuGet packages and VS extension", "Write Feature files in Gherkin (Given/When/Then)", "Generate Step Definition classes", "Implement step methods with Selenium code", "Use Scenario Context for data sharing", "Generate Living Documentation reports" }
        },
        new ProjectItem {
            Title = "API + UI Hybrid Framework", Level = "Advanced", Time = "12h", Tech = "RestSharp + Selenium + NUnit",
            Desc = "Combine API testing with UI testing in a single framework — use API for setup/teardown and UI for validation.",
            Steps = new List<string> { "Setup RestSharp for API calls", "Create test data via API before UI tests", "Use API tokens for authenticated UI sessions", "Validate API responses match UI display", "Clean up test data via API after tests", "Generate combined API+UI test report" }
        },
        new ProjectItem {
            Title = "Custom Test Report Dashboard", Level = "Advanced", Time = "8h", Tech = "ExtentReports + JSON + HTML",
            Desc = "Build a comprehensive test reporting solution with charts, screenshots, logs, and historical trend analysis.",
            Steps = new List<string> { "Integrate ExtentReports with NUnit hooks", "Capture screenshots on every failure automatically", "Add step-level logging with timestamps", "Generate JSON output for trend analysis", "Create custom HTML dashboard with charts", "Email reports automatically after test run" }
        }
    };
    // --- PROJECTS DATA END ---

    public class ProjectItem {
        public string Title { get; set; } = "";
        public string Level { get; set; } = "";
        public string Time { get; set; } = "";
        public string Tech { get; set; } = "";
        public string Desc { get; set; } = "";
        public List<string> Steps { get; set; } = new();
    }
}
