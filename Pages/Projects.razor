@code {
    private string SelectedLevel = "All";
    private bool DisplayModal = false;
    private ProjectItem? SelectedProject;

    private void FilterProjects(string level) => SelectedLevel = level;

    private List<ProjectItem> FilteredProjects => SelectedLevel == "All" 
        ? AllProjects 
        : AllProjects.Where(p => p.Level == SelectedLevel).ToList();

    private void ShowGuide(ProjectItem project)
    {
        SelectedProject = project;
        DisplayModal = true;
    }

    private void CloseModal() => DisplayModal = false;

    private string GetLevelClass(string level) => level switch {
        "Beginner" => "bg-success",
        "Intermediate" => "bg-warning text-dark",
        "Advanced" => "bg-danger",
        _ => "bg-secondary"
    };

    // --- PROJECTS DATA START ---
    private List<ProjectItem> AllProjects = new List<ProjectItem> {
        // 🟢 BEGINNER PROJECTS
        new ProjectItem {
            Title = "Login Form Validator", Level = "Beginner", Time = "2h", Tech = "Selenium Core + Assertions",
            Desc = "Automate a standard login page with positive and negative test cases. Learn locator strategies and basic assertions.",
            Steps = new List<string> { "Launch Chrome using ChromeDriver instance", "Identify locators using ID, Name, CSS Selector", "Write negative test cases with invalid credentials", "Verify error messages using Assert.AreEqual()", "Assert URL change on successful login" }
        },
        new ProjectItem {
            Title = "Alerts & Window Handler", Level = "Beginner", Time = "3h", Tech = "IAlert & Window Handles",
            Desc = "Handle JavaScript popups, confirmation boxes, and multiple browser tabs using SwitchTo() API.",
            Steps = new List<string> { "Open Demo Alert page with different popup types", "Handle JS Alert using SwitchTo().Alert().Accept()", "Handle Confirmation Box with Accept/Dismiss", "Handle Prompt Alert with SendKeys()", "Switch between multiple Tabs using WindowHandles" }
        },
        new ProjectItem {
            Title = "Form Automation Suite", Level = "Beginner", Time = "3h", Tech = "SelectElement + SendKeys",
            Desc = "Automate a registration form covering text inputs, dropdowns, radio buttons, checkboxes, and date pickers.",
            Steps = new List<string> { "Fill text fields using SendKeys()", "Select dropdown values using SelectElement class", "Handle radio buttons and checkboxes with Click()", "Upload a file using SendKeys on file input", "Submit form and verify success message" }
        },
        new ProjectItem {
            Title = "Navigation & Cookies Manager", Level = "Beginner", Time = "2h", Tech = "ICookieJar + Navigate()",
            Desc = "Navigate forward/back/refresh and manage browser cookies programmatically.",
            Steps = new List<string> { "Use Navigate().GoToUrl(), Back(), Forward(), Refresh()", "Read all cookies using Manage().Cookies", "Add custom cookies for session testing", "Delete specific and all cookies", "Verify cookie values after page actions" }
        },
        new ProjectItem {
            Title = "Screenshot & Reporting Basics", Level = "Beginner", Time = "2h", Tech = "ITakesScreenshot + File I/O",
            Desc = "Capture full-page screenshots on test failure and save them with timestamps.",
            Steps = new List<string> { "Implement ITakesScreenshot interface", "Capture screenshot on test failure using try-catch", "Save with timestamp-based filename", "Organize screenshots in folders by date", "Log test results to a text file" }
        },
        new ProjectItem {
            Title = "Table Data Extractor", Level = "Beginner", Time = "3h", Tech = "FindElements + XPath",
            Desc = "Read and validate HTML table data including headers, rows, and specific cell values.",
            Steps = new List<string> { "Locate table using CSS/XPath selector", "Extract all headers using th elements", "Iterate rows and cells using FindElements", "Search for specific data in table", "Validate row count and cell values" }
        },

        // 🟡 INTERMEDIATE PROJECTS
        new ProjectItem {
            Title = "E-Commerce Product Scraper", Level = "Intermediate", Time = "6h", Tech = "Dynamic XPaths + WebDriverWait",
            Desc = "Extract product names, prices, and ratings from a live e-commerce site with pagination support.",
            Steps = new List<string> { "Navigate to product listing page", "Wait for dynamic elements using WebDriverWait", "Use FindElements to collect product cards", "Extract text, price, and rating from each card", "Handle pagination and collect data across pages", "Export results to CSV file" }
        },
        new ProjectItem {
            Title = "Data Driven Framework", Level = "Intermediate", Time = "8h", Tech = "Excel + NUnit + EPPlus",
            Desc = "Run the same test with 100 different data sets from an external Excel file using parameterized testing.",
            Steps = new List<string> { "Setup NUnit Test Project with EPPlus package", "Create Excel test data file with multiple sheets", "Read data using OfficeOpenXml library", "Use [TestCaseSource] attribute for parameterization", "Log pass/fail status for each data row", "Generate summary report" }
        },
        new ProjectItem {
            Title = "iFrame & Shadow DOM Handler", Level = "Intermediate", Time = "5h", Tech = "SwitchTo().Frame() + JS Executor",
            Desc = "Automate elements inside nested iFrames and Shadow DOM components that standard locators can't reach.",
            Steps = new List<string> { "Identify iframe elements on page", "Switch to iframe using SwitchTo().Frame()", "Handle nested iframes (frame within frame)", "Switch back using DefaultContent()/ParentFrame()", "Access Shadow DOM using IJavaScriptExecutor", "Chain shadow root queries for nested shadows" }
        },
        new ProjectItem {
            Title = "Drag & Drop + Complex Actions", Level = "Intermediate", Time = "4h", Tech = "Actions Class + Builder Pattern",
            Desc = "Implement complex mouse and keyboard interactions including drag-drop, hover, right-click, and double-click.",
