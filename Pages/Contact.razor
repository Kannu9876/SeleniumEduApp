@page "/contact"

<PageTitle>Contact Us - SeleniumEduApp</PageTitle>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-7">
            <h1>Contact Us</h1>
            <p class="lead">Have a question or feedback? We'd love to hear from you!</p>
            <hr />
            <div class="card shadow-sm border-0 bg-light p-5">
                <h4 class="mb-3">Get in Touch</h4>
                <p class="mb-1">For support or business inquiries, please email us at:</p>
                <a href="mailto:support@seleniumeduapp.com" class="h5 text-primary">support@seleniumeduapp.com</a>
                <p class="mt-4 text-muted">We aim to respond to all inquiries within 48 hours.</p>
            </div>

            <div class="row mt-4 text-start g-3">
                <div class="col-md-6">
                    <div class="card border-0 bg-light p-3 h-100">
                        <h6 class="fw-bold">🐛 Bug Reports</h6>
                        <p class="small text-muted mb-0">Found an issue with our AI tools or the website? Let us know and we'll fix it promptly.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 bg-light p-3 h-100">
                        <h6 class="fw-bold">💡 Feature Requests</h6>
                        <p class="small text-muted mb-0">Have an idea for a new learning module or tool? We'd love to hear your suggestions.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 bg-light p-3 h-100">
                        <h6 class="fw-bold">🤝 Partnerships</h6>
                        <p class="small text-muted mb-0">Interested in collaborating or advertising on SeleniumEduApp? Reach out to us directly.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 bg-light p-3 h-100">
                        <h6 class="fw-bold">📚 Content Feedback</h6>
                        <p class="small text-muted mb-0">Spotted an error in our tutorials or interview questions? Help us improve our content quality.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
