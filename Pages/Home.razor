@page "/"

<PageTitle>SeleniumEduApp - Free AI-Powered C# Selenium Tutor, Debugger & Interview Prep</PageTitle>

<GoogleAd />

<div class="container text-center mt-5 mb-5">
    <h1 class="display-4 fw-bold" style="color: #512BD4;">Welcome to Selenium C# Master 🚀</h1>
    <p class="lead mt-3">Your AI-Powered Tutor & Debugging Assistant for Selenium Automation Testing</p>
    
    <hr class="my-4" />
    
    <div class="row justify-content-center">
        <div class="col-md-8">
            <p class="mb-4 fs-5">
                Master web automation using C# and Selenium with our interactive AI-driven platform. 
                Whether you are a beginner or looking to solve complex automation errors, our tools 
                are designed to provide real-time solutions and hands-on practice.
            </p>
        </div>
    </div>
    
    <div class="d-flex justify-content-center gap-3 mt-3">
        <a href="/learn" class="btn btn-primary btn-lg px-4" style="background-color: #512BD4; border: none;">
            Start Learning
        </a>
        <a href="/debug" class="btn btn-outline-danger btn-lg px-4">
            Fix an Error
        </a>
